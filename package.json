{
  "name": "repo-vector",
  "version": "0.1.0",
  "description": "Keep a vector index of a git repository current after every push, in Pinecone or Postgres/pgvector, and search it from a CLI, HTTP or MCP.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "repo-vector": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "files": [
    "dist/cli.js",
    "dist/tree-sitter.wasm",
    "dist/grammars"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "coverage": "c8 --include 'src/**' --exclude src/action.ts --exclude src/cli.ts --exclude src/mcp.ts --reporter text-summary --reporter text node --import tsx --test \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/cli.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@pinecone-database/pinecone": "^9.0.0",
    "picomatch": "^4.0.2",
    "postgres": "^3.4.9",
    "web-tree-sitter": "0.25.10",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/picomatch": "^4.0.0",
    "c8": "^10.1.3",
    "esbuild": "^0.28.2",
    "tree-sitter-wasms": "0.1.13",
    "tsx": "^4.23.15",
    "typescript": "^5.8.0"
  }
}
