# ---------- Store (required) ----------
# pinecone or postgres
REPO_VECTOR_STORE=
# Pinecone store
PINECONE_API_KEY=
# Postgres store: any Postgres with pgvector (docker compose here, Supabase, Neon, RDS ...)
DATABASE_URL=
# Index name. Default: the repository name (Pinecone: lowercase letters, digits, hyphens, max 45)
REPO_VECTOR_INDEX=
# Let the action create a missing Pinecone index (Postgres tables are always created on first use)
REPO_VECTOR_CREATE_INDEX=false
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ---------- Embedding (required for indexing; queries read it from the index) ----------
# pinecone (hosted, Pinecone store only), openrouter or openai
REPO_VECTOR_EMBEDDING_PROVIDER=
# e.g. llama-text-embed-v2 | openai/text-embedding-3-small | text-embedding-3-small
REPO_VECTOR_EMBEDDING_MODEL=
# Optional truncation for models that support it, e.g. 512
REPO_VECTOR_EMBEDDING_DIMENSIONS=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
# Any OpenAI-compatible embeddings endpoint
OPENAI_BASE_URL=https://api.openai.com/v1
# deny: OpenRouter routes only to providers that do not retain inputs
REPO_VECTOR_OPENROUTER_DATA_COLLECTION=deny
# Pace in tokens per minute. Default 250000 for Pinecone hosted (Starter limit), unpaced otherwise
REPO_VECTOR_EMBED_TOKENS_PER_MINUTE=

# ---------- Where results live (defaults work in GitHub Actions) ----------
# owner/name and branch; needed where there is no checkout (the Docker API)
REPO_VECTOR_REPO=
REPO_VECTOR_BRANCH=
# Override the namespace entirely (default: <owner>-<repo>--<branch>)
REPO_VECTOR_NAMESPACE=

# ---------- Indexing ----------
# Comma-separated globs on top of the built-in excludes
REPO_VECTOR_EXCLUDE=
REPO_VECTOR_MAX_FILE_KB=512
REPO_VECTOR_CHUNK_TARGET=1200
REPO_VECTOR_CHUNK_MAX=2400
REPO_VECTOR_BATCH_SIZE=48
REPO_VECTOR_FULL_REINDEX=false
REPO_VECTOR_MAX_DIFF_RATIO=0.4
REPO_VECTOR_HISTORY=true
REPO_VECTOR_HISTORY_MAX_COMMITS=20000

# ---------- HTTP API ----------
# Required unless the host is 127.0.0.1
REPO_VECTOR_SERVER_TOKEN=
REPO_VECTOR_SERVER_HOST=
REPO_VECTOR_SERVER_PORT=8080
REPO_VECTOR_SERVER_CORS_ORIGIN=
REPO_VECTOR_TOPK_MAX=100

# ---------- docker compose only ----------
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
# 127.0.0.1 keeps Postgres private to this host (a self-hosted runner here can still reach it).
POSTGRES_BIND=127.0.0.1
